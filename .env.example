# Copy this file to .env or .env.local and fill in the values

# Firebase/Google Cloud setup
VITE_SITE_URL=http://localhost:3000

# Crypto Payment Gateway (NOWPayments)
# Get this from NOWPayments Dashboard -> Settings -> API Keys
NOWPAYMENTS_API_KEY=
# Get this from NOWPayments Dashboard -> Settings -> Instant Payment Notifications
NOWPAYMENTS_IPN_SECRET=
GEMINI_API_KEY=

# Firebase Admin Service Account JSON (stringified)
# Required for server-side logic (webhooks, intervals)
FIREBASE_SERVICE_ACCOUNT=

# Payment Gateways

# Payment Gateways (Bachs)
BACHS_API_KEY=
BACHS_ENV=sandbox
BACHS_WEBHOOK_SECRET=
BACHS_PRODUCT_ID=prod_your_normal_deposit

# Aetheris Flex Bachs Subscription Products (by recurring interval in days)
BACHS_FLEX_SUBSCRIPTION_DAY_1=prod_REPLACE_DAY_1
BACHS_FLEX_SUBSCRIPTION_DAY_2=prod_REPLACE_DAY_2
BACHS_FLEX_SUBSCRIPTION_DAY_3=prod_REPLACE_DAY_3
BACHS_FLEX_SUBSCRIPTION_DAY_4=prod_REPLACE_DAY_4
BACHS_FLEX_SUBSCRIPTION_DAY_5=prod_REPLACE_DAY_5
BACHS_FLEX_SUBSCRIPTION_DAY_6=prod_REPLACE_DAY_6
BACHS_FLEX_SUBSCRIPTION_DAY_7=prod_REPLACE_DAY_7
APP_URL=http://localhost:3000

# Cloudinary Upload
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Resend for Emails
RESEND_API_KEY=
FROM_EMAIL=support@update.aetheriss.online
SYSTEM_EMAIL=no-reply@aetherisvault.net
SUPPORT_EMAIL=support@aetherisvault.net

# Inbound Email Webhook
INBOUND_WEBHOOK_SECRET=
INBOUND_PROVIDER=generic

# Brevo SMTP Configuration
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_PASS=

# Firebase Cloud Messaging Public VAPID Key (Optional, get from Firebase Console)
VITE_FIREBASE_VAPID_KEY=
